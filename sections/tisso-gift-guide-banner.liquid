    </div>

    <!-- Promotional message -->
    <div class="tisso-header__message">
      {{ section.settings.header_text | default: 'Find the ideal gift for your loved ones.' }}
    </div>

    <!-- Yellow Choose Gift CTA -->
    <a
      href="{{ section.settings.header_button_url | default: '#tisso-product-grid' }}"
      class="tisso-header__button"
      aria-label="{{ section.settings.header_button_text | default: 'CHOOSE GIFT' }}"
    >
      <span class="tisso-header__button-text">
        {{ section.settings.header_button_text | default: 'CHOOSE GIFT' }}
      </span>
      <span class="tisso-header__arrow" aria-hidden="true">
        <svg width="26" height="12" viewBox="0 0 26 12" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M0.75 4.77298L7.37629e-08 4.77298L-7.37629e-08 6.27298L0.75 6.27298L0.75 4.77298ZM25.2803 6.05331C25.5732 5.76042 25.5732 5.28554 25.2803 4.99265L20.5074 0.21968C20.2145 -0.073213 19.7396 -0.0732131 19.4467 0.21968C19.1538 0.512574 19.1538 0.987447 19.4467 1.28034L23.6893 5.52298L19.4467 9.76562C19.1538 10.0585 19.1538 10.5334 19.4467 10.8263C19.7396 11.1192 20.2145 11.1192 20.5074 10.8263L25.2803 6.05331ZM0.75 6.27298L24.75 6.27298L24.75 4.77298L0.75 4.77298L0.75 6.27298Z" fill="currentColor"/>
        </svg>
      </span>
    </a>
  </div>
</header>

<!-- EXACT FIGMA HERO SECTION -->
<section class="tisso-gift-guide-hero section-{{ section.id }}-padding" data-section-id="{{ section.id }}">
  <!-- 1. DESKTOP HERO CANVAS (1440px x 780px) -->
  <div class="tisso-hero-canvas-desktop">
    <!-- Desktop Illustration (Top 390px) -->
    <div class="tisso-hero-illustration-desktop" aria-hidden="true">
      {%- if section.settings.background_image != blank -%}
        {{
          section.settings.background_image
          | image_url: width: 1800
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '1100, 1440, 1800',
            alt: section.settings.desktop_heading | default: 'The Gift Guide illustration'
        }}
      {%- else -%}
        <img
          src="{{ 'tisso-banner-illustration.svg' | asset_url }}"
          alt="{{ section.settings.desktop_heading | default: 'The Gift Guide illustration' }}"
          width="1440"
          height="390"
          loading="eager"
        >
      {%- endif -%}
    </div>

    <!-- Desktop Heading (left: 67px, top: 425px) -->
    <h1 class="tisso-gift-guide-hero__title--desktop">
      {{ section.settings.desktop_heading | default: 'The Gift Guide' }}
    </h1>

    <!-- Desktop Description (left: 67px, top: 545px, width: 483px) -->
    <div class="tisso-gift-guide-hero__description--desktop">
      {{ section.settings.desktop_description | default: 'Discover Joy: Your Ultimate Holiday Gift Destination.<br>Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.' }}
    </div>

    <!-- Desktop CTA Button (left: 67px, top: 679px, width: 220px, height: 50px) -->
    <a
      href="{{ section.settings.desktop_shop_now_url | default: '#tisso-product-grid' }}"
      class="tisso-gift-guide-hero__button--desktop"
      aria-label="{{ section.settings.desktop_shop_now_text | default: 'SHOP NOW' }}"
    >
      <span>{{ section.settings.desktop_shop_now_text | default: 'SHOP NOW' }}</span>
      <span class="tisso-hero__arrow" aria-hidden="true">
        <svg width="27" height="12" viewBox="0 0 27 12" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M0.75 4.77298L7.37629e-08 4.77298L-7.37629e-08 6.27298L0.75 6.27298L0.75 4.77298ZM25.2803 6.05331C25.5732 5.76042 25.5732 5.28554 25.2803 4.99265L20.5074 0.21968C20.2145 -0.073213 19.7396 -0.0732131 19.4467 0.21968C19.1538 0.512574 19.1538 0.987447 19.4467 1.28034L23.6893 5.52298L19.4467 9.76562C19.1538 10.0585 19.1538 10.5334 19.4467 10.8263C19.7396 11.1192 20.2145 11.1192 20.5074 10.8263L25.2803 6.05331ZM0.75 6.27298L24.75 6.27298L24.75 4.77298L0.75 4.77298L0.75 6.27298Z" fill="currentColor"/>
        </svg>
      </span>
    </a>
  </div>

  <!-- 2. MOBILE HERO CANVAS (375px x 421px) -->
  <div class="tisso-hero-canvas-mobile">
    <!-- Mobile Heading (top: 49px, center) -->
    <h1 class="tisso-gift-guide-hero__title--mobile">
      {{ section.settings.mobile_heading | default: 'The Gift Guide' }}
    </h1>

    <!-- Mobile Description (top: 103px, width: 340px, center) -->
    <div class="tisso-gift-guide-hero__description--mobile">
      {{ section.settings.mobile_description | default: 'Discover Joy: Your Ultimate Holiday Gift Destination.' }}
    </div>

    <!-- Mobile Illustration Frame (686px x 264px at top: 157px) -->
    <div class="tisso-hero-illustration-mobile" aria-hidden="true">
      {%- if section.settings.mobile_background_image != blank -%}
        {{
          section.settings.mobile_background_image
          | image_url: width: 800
          | image_tag:
            loading: 'eager',
            widths: '400, 686, 800',
            alt: section.settings.mobile_heading | default: 'The Gift Guide mobile illustration'
        }}
      {%- else -%}
        <img
          src="{{ 'tisso-banner-illustration.svg' | asset_url }}"
          alt="{{ section.settings.mobile_heading | default: 'The Gift Guide mobile illustration' }}"
          width="686"
          height="264"
          loading="eager"
        >
      {%- endif -%}
    </div>

    <!-- Mobile CTA Button (top: 337px, center) -->
    <a
      href="{{ section.settings.mobile_shop_now_url | default: section.settings.desktop_shop_now_url | default: '#tisso-product-grid' }}"
      class="tisso-gift-guide-hero__button--mobile"
      aria-label="{{ section.settings.mobile_shop_now_text | default: 'SHOP NOW' }}"
    >
      <span>{{ section.settings.mobile_shop_now_text | default: 'SHOP NOW' }}</span>
      <span class="tisso-hero__arrow" aria-hidden="true">
        <svg width="26" height="12" viewBox="0 0 26 12" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M0.75 4.77298L7.37629e-08 4.77298L-7.37629e-08 6.27298L0.75 6.27298L0.75 4.77298ZM25.2803 6.05331C25.5732 5.76042 25.5732 5.28554 25.2803 4.99265L20.5074 0.21968C20.2145 -0.073213 19.7396 -0.0732131 19.4467 0.21968C19.1538 0.512574 19.1538 0.987447 19.4467 1.28034L23.6893 5.52298L19.4467 9.76562C19.1538 10.0585 19.1538 10.5334 19.4467 10.8263C19.7396 11.1192 20.2145 11.1192 20.5074 10.8263L25.2803 6.05331ZM0.75 6.27298L24.75 6.27298L24.75 4.77298L0.75 4.77298L0.75 6.27298Z" fill="#F5F5F5"/>
        </svg>
      </span>
    </a>
  </div>

  <!-- Bottom Announcement Bar -->
  {%- if section.settings.desktop_announcement_text != blank or section.settings.mobile_announcement_text != blank or section.settings.announcement_text != blank -%}
    <div class="tisso-banner-announcement">
      <div class="tisso-banner-announcement--desktop">
        {{ section.settings.desktop_announcement_text | default: section.settings.announcement_text | default: 'SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL' }}
      </div>
      <div class="tisso-banner-announcement--mobile">
        {{ section.settings.mobile_announcement_text | default: section.settings.announcement_text | default: 'SUSTAINABLE, ETHICALLY MADE ACTIVEWEAR' }}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Tisso Gift Guide Banner",
  "tag": "section",
  "class": "section-tisso-banner",
  "settings": [
    {
      "type": "header",
      "content": "Header Settings"
    },
    {
      "type": "text",
      "id": "header_text",
      "label": "Header promotional text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "header_button_text",
      "label": "Header Button Text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "header_button_url",
      "label": "Header Button URL"
    },
    {
      "type": "header",
      "content": "Desktop Hero Content"
    },
    {
      "type": "text",
      "id": "desktop_heading",
      "label": "Desktop Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "desktop_description",
      "label": "Desktop Description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination.\nExplore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "desktop_shop_now_text",
      "label": "Desktop Shop Now Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "desktop_shop_now_url",
      "label": "Desktop Shop Now URL"
    },
    {
      "type": "header",
      "content": "Mobile Hero Content"
    },
    {
      "type": "text",
      "id": "mobile_heading",
      "label": "Mobile Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "mobile_description",
      "label": "Mobile Description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination."
    },
    {
      "type": "text",
      "id": "mobile_shop_now_text",
      "label": "Mobile Shop Now Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "mobile_shop_now_url",
      "label": "Mobile Shop Now URL"
    },
    {
      "type": "header",
      "content": "Background / Illustration"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Desktop Background Image Override"
    },
    {
      "type": "image_picker",
      "id": "mobile_background_image",
      "label": "Mobile Background Image Override"
    },
    {
      "type": "header",
      "content": "Bottom Announcement"
    },
    {
      "type": "text",
      "id": "desktop_announcement_text",
      "label": "Desktop Announcement Text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    },
    {
      "type": "text",
      "id": "mobile_announcement_text",
      "label": "Mobile Announcement Text",
      "default": "SUSTAINABLE, ETHICALLY MADE ACTIVEWEAR"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Tisso Gift Guide Banner"
    }
  ]
}
{% endschema %}
